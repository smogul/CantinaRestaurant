# Copy to .env and replace the placeholder values. Docker Compose loads this file first, then .env, so .env wins.
# Names with a double underscore are read by the API directly, for example Jwt__SigningKey becomes Jwt:SigningKey.
ASPNETCORE_ENVIRONMENT=Development
API_PORT=8080
POSTGRES_DB=cantina
POSTGRES_USER=cantina
POSTGRES_PASSWORD=change-me
# GSS Encryption Mode=Disable stops Npgsql probing for Kerberos libraries the runtime image does not ship.
ConnectionStrings__CantinaDb=Host=postgres;Port=5432;Database=${POSTGRES_DB};Username=${POSTGRES_USER};Password=${POSTGRES_PASSWORD};GSS Encryption Mode=Disable
# Signs access tokens. Use a random secret of at least 32 bytes, for example the output of: openssl rand -base64 48
Jwt__SigningKey=change-me-to-a-random-secret-of-at-least-32-bytes
# Accounts seeded on first start, only when the Users table is empty.
Seed__AdminName=Chalmun
Seed__AdminEmail=admin@cantina.example
Seed__AdminPassword=ChangeMe-Admin-1
Seed__CustomerName=Han Solo
Seed__CustomerEmail=customer@cantina.example
Seed__CustomerPassword=ChangeMe-Customer-1


ITEM_A=$(curl -s "$BASE/api/menu-items" -H "Authorization: Bearer $CUSTOMER_TOKEN" | jq -r '.items[0].id')
ITEM_B=$(curl -s "$BASE/api/menu-items" -H "Authorization: Bearer $CUSTOMER_TOKEN" | jq -r '.items[1].id')
echo "$ITEM_A $ITEM_B"
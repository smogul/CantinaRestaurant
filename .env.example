# Copy to .env and replace the placeholder values.
ASPNETCORE_ENVIRONMENT=Development
API_PORT=8080
POSTGRES_DB=cantina
POSTGRES_USER=cantina
POSTGRES_PASSWORD=change-me
# GSS Encryption Mode=Disable stops Npgsql probing for Kerberos libraries the runtime image does not ship.
CANTINA_DB_CONNECTION_STRING=Host=postgres;Port=5432;Database=${POSTGRES_DB};Username=${POSTGRES_USER};Password=${POSTGRES_PASSWORD};GSS Encryption Mode=Disable

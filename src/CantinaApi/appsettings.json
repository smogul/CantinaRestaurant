{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "Microsoft.EntityFrameworkCore.Migrations": "Information"
      }
    }
  },
  "Jwt": {
    "Issuer": "CantinaApi",
    "Audience": "CantinaApi.Clients",
    "LifetimeMinutes": 60
  },
  "Auth": {
    "BcryptWorkFactor": 12,
    "Lockout": {
      "MaxFailedAttempts": 5,
      "DurationMinutes": 15
    }
  },
  "RateLimiting": {
    "Login": {
      "PermitLimit": 10,
      "WindowSeconds": 60
    },
    "Register": {
      "PermitLimit": 5,
      "WindowSeconds": 60
    }
  },
  "ForwardedHeaders": {
    "KnownProxies": []
  },
  "Caching": {
    "MenuSeconds": 60,
    "SearchSeconds": 30
  },
  "Seed": {
    "Enabled": false,
    "AdminName": "Chalmun",
    "CustomerName": "Han Solo"
  },
  "AllowedHosts": "*"
}
